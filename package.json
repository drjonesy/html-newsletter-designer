{
  "name": "html-newsletter-designer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist extension/app",
    "lint": "tsc --noEmit",
    "build:extension": "vite build --base=./ --outDir=extension/app --emptyOutDir",
    "package:extension": "pnpm build:extension && mkdir -p dist && rm -f dist/newsletter-designer-extension.zip && cd extension && zip -qr ../dist/newsletter-designer-extension.zip . -x '.DS_Store' '**/.DS_Store' && echo 'dist/newsletter-designer-extension.zip'"
  },
  "dependencies": {
    "@lexical/html": "^0.48.0",
    "@lexical/link": "^0.48.0",
    "@lexical/react": "^0.48.0",
    "@lexical/selection": "^0.48.0",
    "@lexical/utils": "^0.48.0",
    "lexical": "^0.48.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
